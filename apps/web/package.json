{
  "name": "@hoop-rush/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --incremental --watch --tsconfig ./tsconfig.json",
    "lint": "prettier --cache --check src eslint.config.js && eslint --cache .",
    "test": "bun test --watch --preload ./bun-test-preload.ts",
    "test:run": "bun test --preload ./bun-test-preload.ts",
    "test:quick": "bun test --preload ./bun-test-preload.ts --path-ignore-patterns \"**/*generator*\" --path-ignore-patterns \"**/*integration*\"",
    "test:unit": "bun test --preload ./bun-test-preload.ts src/lib"
  },
  "dependencies": {
    "@hoop-rush/application": "workspace:*",
    "@hoop-rush/data-contracts": "workspace:*",
    "@hoop-rush/engine": "workspace:*",
    "@hoop-rush/persistence": "workspace:*",
    "@lucide/svelte": "^1.55.0",
    "@supabase/supabase-js": "^2.117.3",
    "bits-ui": "^2.19.5",
    "dexie": "^4.4.6",
    "mode-watcher": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hoop-rush/test-fixtures": "workspace:*",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "^3.23.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.3.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
