{
  "name": "@hoop-rush/cli",
  "private": true,
  "type": "module",
  "bin": {
    "hoop-rush": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --incremental",
    "lint": "prettier --cache --check src eslint.config.js && eslint --cache src eslint.config.js",
    "test": "bun test --watch --isolate --timeout 30000",
    "test:run": "bun test --isolate --timeout 30000",
    "test:quick": "bun test --isolate --timeout 30000 --path-ignore-patterns \"**/*generator*\" --path-ignore-patterns \"**/*integration*\"",
    "hoop-rush": "bun src/index.ts",
    "gen-fixtures": "bun src/gen-fixtures.ts",
    "gen-collection-catalog": "bun src/gen-collection-catalog.ts"
  },
  "dependencies": {
    "@hoop-rush/data-contracts": "workspace:*",
    "@hoop-rush/engine": "workspace:*",
    "@hoop-rush/importer": "workspace:*",
    "@hoop-rush/persistence": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hoop-rush/test-fixtures": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "dexie": "^4.4.6",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "typescript": "catalog:"
  }
}
