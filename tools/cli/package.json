{
  "name": "@hoop-rush/cli",
  "private": true,
  "type": "module",
  "bin": {
    "hoop-rush": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --incremental",
    "lint": "prettier --cache --check src vitest.config.ts eslint.config.js && eslint --cache .",
    "test": "vitest",
    "test:run": "vitest run",
    "hoop-rush": "node src/index.ts",
    "gen-fixtures": "tsx src/gen-fixtures.ts",
    "gen-season-assets": "tsx src/gen-season-assets.ts",
    "gen-season-free-agency-index": "tsx src/gen-season-free-agency-index.ts",
    "gen-season-draft-catalog": "tsx src/gen-season-draft-catalog.ts",
    "gen-collection-catalog": "tsx src/gen-collection-catalog.ts",
    "gen-sponsor-gear-assets": "tsx src/gen-sponsor-gear-assets.ts"
  },
  "dependencies": {
    "@hoop-rush/data-contracts": "workspace:*",
    "@hoop-rush/engine": "workspace:*",
    "@hoop-rush/importer": "workspace:*",
    "@hoop-rush/persistence": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hoop-rush/test-fixtures": "workspace:*",
    "@types/node": "catalog:",
    "dexie": "^4.4.4",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
