{
  "name": "@hoop-rush/cli",
  "private": true,
  "type": "module",
  "bin": {
    "hoop-rush": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --incremental",
    "lint": "prettier --cache --check src vitest.config.ts eslint.config.js && eslint --cache .",
    "test": "vitest",
    "test:run": "vitest run",
    "hoop-rush": "tsx src/index.ts",
    "gen-fixtures": "tsx src/gen-fixtures.ts",
    "gen-season-assets": "tsx src/gen-season-assets.ts",
    "gen-season-draft-catalog": "tsx src/gen-season-draft-catalog.ts"
  },
  "dependencies": {
    "@hoop-rush/data-contracts": "workspace:*",
    "@hoop-rush/engine": "workspace:*",
    "@hoop-rush/importer": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hoop-rush/test-fixtures": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
