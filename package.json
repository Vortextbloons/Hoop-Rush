{
  "name": "hoop-rush",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hoop-rush/web dev",
    "build": "pnpm --filter @hoop-rush/web build",
    "preview": "pnpm --filter @hoop-rush/web preview",
    "hoop-rush": "pnpm --filter @hoop-rush/cli hoop-rush",
    "check": "pnpm --parallel -r check",
    "lint": "pnpm --parallel -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code-size": "python scripts/code-size/measure.py",
    "test": "vitest",
    "test:run": "vitest run",
    "//test:quick": "Fast PR gate. The exclude list is mirrored in scripts/tests/quick-exclusions.json and checked by `pnpm check:test-exclusions` (parity, stale patterns, and quick != run). Rationale per pattern lives in the manifest.",
    "test:quick": "vitest run --exclude=\"**/*generator*\" --exclude=\"**/*integration*\"",
    "test:import-nba": "python -m unittest discover -s scripts/import-nba -p \"test_*.py\"",
    "static": "pnpm --parallel -r run \"/^(check|lint)$/\"",
    "check:test-exclusions": "node scripts/tests/check-quick-exclusions.mjs",
    "verify:quick": "pnpm static && pnpm check:test-exclusions && pnpm test:quick",
    "verify": "pnpm static && pnpm test:run && pnpm build",
    "verify:changed": "pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present run \"/^(check|lint)$/\" && pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present test:run",
    "check:watch:web": "pnpm --filter @hoop-rush/web check:watch",
    "test:watch:web": "vitest watch --project @hoop-rush/web",
    "test:watch:engine": "vitest watch --project @hoop-rush/engine",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.11.0",
  "lint-staged": {
    "*.{ts,js,svelte,json,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@sveltejs/mcp": "^0.1.26",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
