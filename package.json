{
  "name": "hoop-rush",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hoop-rush/web dev",
    "build": "pnpm --filter @hoop-rush/web build",
    "preview": "pnpm --filter @hoop-rush/web preview",
    "hoop-rush": "pnpm --filter @hoop-rush/cli hoop-rush",
    "check": "pnpm --parallel -r check",
    "lint": "pnpm --parallel -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "//test:quick": "Excludes only the slow multi-second suites: generator golden regeneration, the two heavy CLI integration tiers (season rosters, season M2.5 calibration), block determinism, the fast-check property suites (sim properties, season-game properties), the season orchestration tiers (season block, block effects, block injuries, season schedule, AI generation/selection/projection, CLI season block/benchmark/effects, bracket generation). Everything else, including other cli-*.test.ts files, runs.",
    "test:quick": "vitest run --exclude \"**/generator*.test.ts\" --exclude \"**/cli-season-rosters*.test.ts\" --exclude \"**/cli-season-m25.test.ts\" --exclude \"**/block-determinism.test.ts\" --exclude \"**/properties.test.ts\" --exclude \"**/season-game-properties.test.ts\" --exclude \"**/block-effects.test.ts\" --exclude \"**/season/schedule.test.ts\" --exclude \"**/ai-generation-v2.test.ts\" --exclude \"**/cli-season-effects.test.ts\" --exclude \"**/cli-season-benchmark.test.ts\" --exclude \"**/cli-season-block.test.ts\" --exclude \"**/bracket-generate.test.ts\" --exclude \"**/ai-projection.test.ts\" --exclude \"**/ai.test.ts\" --exclude \"**/block-injuries.test.ts\"",
    "static": "pnpm --parallel -r run \"/^(check|lint)$/\"",
    "e2e": "pnpm --filter @hoop-rush/web e2e",
    "e2e:smoke": "pnpm --filter @hoop-rush/web e2e:smoke",
    "verify:quick": "pnpm static && pnpm test:quick",
    "verify": "pnpm static && pnpm test:run && pnpm build",
    "verify:changed": "pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present run \"/^(check|lint)$/\" && pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present test:run",
    "check:watch:web": "pnpm --filter @hoop-rush/web check:watch",
    "test:watch:web": "vitest watch --project @hoop-rush/web",
    "test:watch:engine": "vitest watch --project @hoop-rush/engine",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.11.0",
  "lint-staged": {
    "*.{ts,js,svelte,json,css,html,yml,yaml}": "prettier --write",
    "!raw-data/**": [],
    "!apps/web/static/data/**": []
  },
  "devDependencies": {
    "@sveltejs/mcp": "^0.1.25",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
