{
  "name": "hoop-rush",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @hoop-rush/web dev",
    "build": "bun run --filter @hoop-rush/web build",
    "preview": "bun run --filter @hoop-rush/web preview",
    "hoop-rush": "bun run --filter @hoop-rush/cli hoop-rush",
    "check": "bun run --parallel --filter '*' check",
    "lint": "bun run --parallel --filter '*' lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code-size": "python scripts/code-size/measure.py",
    "test": "bun run --parallel --filter '*' test",
    "test:run": "bun run --parallel --filter '*' test:run",
    "//test:quick": "Fast PR gate. Each workspace test:quick script mirrors its test:run plus the exclusions in scripts/tests/quick-exclusions.json, checked by `bun run check:test-exclusions` (parity per script, stale patterns, and quick != run). Rationale per pattern lives in the manifest.",
    "test:quick": "bun run --parallel --filter '*' test:quick",
    "test:import-nba": "python -m unittest discover -s scripts/import-nba -p \"test_*.py\"",
    "static": "bun run --parallel --filter '*' check lint",
    "check:test-exclusions": "bun scripts/tests/check-quick-exclusions.mjs",
    "verify:quick": "bun run static && bun run check:test-exclusions && bun run test:quick",
    "verify": "bun run static && bun run test:run && bun run build",
    "verify:changed": "bun scripts/verify-changed.mjs",
    "check:watch:web": "bun run --filter @hoop-rush/web check:watch",
    "test:watch:web": "bun run --filter @hoop-rush/web test",
    "test:watch:engine": "bun run --filter @hoop-rush/engine test",
    "prepare": "husky"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild"
  ],
  "lint-staged": {
    "*.{ts,js,svelte,json,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@sveltejs/mcp": "^0.1.26",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "@types/node": "^26.6.5",
      "eslint": "^10.12.0",
      "fake-indexeddb": "^6.2.5",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.71.2"
    }
  }
}
