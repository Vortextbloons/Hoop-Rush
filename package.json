{
  "name": "hoop-rush",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hoop-rush/web dev",
    "build": "pnpm --filter @hoop-rush/web build",
    "preview": "pnpm --filter @hoop-rush/web preview",
    "hoop-rush": "pnpm --filter @hoop-rush/cli hoop-rush",
    "check": "pnpm --parallel -r check",
    "lint": "pnpm --parallel -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "//test:quick": "Fast PR gate. Keeps all sub-second unit suites plus the core guards: engine accounting/command/digest suites (sim core, season-game, season-commands, state-digest, draft, postseason, free-agency, home-court), persistence core (season-run atomicity, repositories, postseason commits), high-risk web worker suites (season-block-runner, season-hub-state), and importer parity. Excludes the slow suites that only need nightly coverage: CLI integration/calibration/benchmark/artifact tiers (cli-season-reproduce, cli-sim-challenge, cli-projection, cli-calibrate*, cli-season-schedule, cli-season-game, cli-replay, cli-benchmark, cli-bracket-audit, cli-season-postseason-audit, cli-season-free-agency, cli-defense-bpm-correlation, pool-identity, commands/import, gen-season-free-agency-index), heavy engine orchestration/property suites (season block/checkpoint/trades/recap/health, sim sensitivity/slot-permutations, projection candidate-search), heavyweight persistence (season-run-free-agency, season-completed-listing, benchmark/season-run), web postseason-runner and history route, importer reconstruction, plus the existing generator/properties/integration tiers.",
    "test:quick": "vitest run --exclude \"**/generator*.test.ts\" --exclude \"**/cli-season-rosters*.test.ts\" --exclude \"**/cli-season-m25.test.ts\" --exclude \"**/block-determinism.test.ts\" --exclude \"**/properties.test.ts\" --exclude \"**/season-game-properties.test.ts\" --exclude \"**/block-effects.test.ts\" --exclude \"**/season/schedule.test.ts\" --exclude \"**/ai-generation-v2.test.ts\" --exclude \"**/cli-season-effects.test.ts\" --exclude \"**/cli-season-benchmark.test.ts\" --exclude \"**/cli-season-block.test.ts\" --exclude \"**/bracket-generate.test.ts\" --exclude \"**/ai-projection.test.ts\" --exclude \"**/ai.test.ts\" --exclude \"**/block-injuries.test.ts\" --exclude \"**/gen-season-free-agency-index.test.ts\" --exclude \"**/commands/import.test.ts\" --exclude \"**/cli-season-schedule.test.ts\" --exclude \"**/cli-season-game.test.ts\" --exclude \"**/commands/pool-identity.test.ts\" --exclude \"**/cli-calibrate-three-point.test.ts\" --exclude \"**/cli-calibrate.test.ts\" --exclude \"**/cli-season-free-agency.test.ts\" --exclude \"**/cli-season-postseason-audit.test.ts\" --exclude \"**/cli-bracket-audit.test.ts\" --exclude \"**/cli-defense-bpm-correlation.test.ts\" --exclude \"**/cli-replay.test.ts\" --exclude \"**/cli-benchmark.test.ts\" --exclude \"**/cli-projection.test.ts\" --exclude \"**/cli-season-reproduce.test.ts\" --exclude \"**/cli-sim-challenge.test.ts\" --exclude \"**/season/health.test.ts\" --exclude \"**/projection/candidate-search.test.ts\" --exclude \"**/season/block.test.ts\" --exclude \"**/season/recap.test.ts\" --exclude \"**/season/checkpoint.test.ts\" --exclude \"**/sim/sensitivity.test.ts\" --exclude \"**/season/trades.test.ts\" --exclude \"**/sim/slot-permutations.test.ts\" --exclude \"**/repositories/season-run-free-agency.test.ts\" --exclude \"**/repositories/season-completed-listing.test.ts\" --exclude \"**/benchmark/season-run.test.ts\" --exclude \"**/season-postseason-runner.test.ts\" --exclude \"**/season-history-route.test.ts\" --exclude \"**/reconstruction/reconstruction.test.ts\"",
    "static": "pnpm --parallel -r run \"/^(check|lint)$/\"",
    "e2e": "pnpm --filter @hoop-rush/web e2e",
    "e2e:smoke": "pnpm --filter @hoop-rush/web e2e:smoke",
    "verify:quick": "pnpm static && pnpm test:quick",
    "verify": "pnpm static && pnpm test:run && pnpm build",
    "verify:changed": "pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present run \"/^(check|lint)$/\" && pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present test:run",
    "check:watch:web": "pnpm --filter @hoop-rush/web check:watch",
    "test:watch:web": "vitest watch --project @hoop-rush/web",
    "test:watch:engine": "vitest watch --project @hoop-rush/engine",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.11.0",
  "lint-staged": {
    "*.{ts,js,svelte,json,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@sveltejs/mcp": "^0.1.25",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
