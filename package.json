{
  "name": "hoop-rush",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hoop-rush/web dev",
    "build": "pnpm --filter @hoop-rush/web build",
    "preview": "pnpm --filter @hoop-rush/web preview",
    "hoop-rush": "pnpm --filter @hoop-rush/cli hoop-rush",
    "check": "pnpm --parallel -r check",
    "lint": "pnpm --parallel -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "//test:quick": "Fast PR gate (artifact: rationale for the enforced --exclude flags in test:quick below; the command is the source of truth and CI asserts quick != run). Keeps all sub-second unit suites plus the core guards: engine accounting/command/digest suites (sim core, season-game, season-commands, state-digest, draft, postseason, free-agency, home-court), persistence core (season-run atomicity, repositories, postseason commits), high-risk web worker suites (season-block-runner, season-hub-state), and importer parity. Excludes the slow suites that run on main pushes: CLI integration/calibration/benchmark/artifact tiers (cli-season-reproduce, cli-sim-challenge, cli-projection, cli-calibrate*, cli-season-schedule, cli-season-game, cli-replay, cli-benchmark, cli-bracket-audit, cli-season-postseason-audit, cli-season-free-agency, cli-defense-bpm-correlation, pool-identity, commands/import, gen-season-free-agency-index), heavy engine orchestration/property suites (season block/checkpoint/trades/recap/health, sim sensitivity/slot-permutations, projection candidate-search), heavyweight persistence (season-run-free-agency, season-completed-listing, benchmark/season-run), web postseason-runner and history route, importer reconstruction, plus the existing generator/properties/integration tiers.",
    "test:quick": "vitest run --exclude=\"**/cli-season-reproduce*\" --exclude=\"**/cli-sim-*\" --exclude=\"**/*calibrate*\" --exclude=\"**/*benchmark*\" --exclude=\"**/cli-season-schedule*\" --exclude=\"**/cli-season-game*\" --exclude=\"**/cli-replay*\" --exclude=\"**/cli-projection*\" --exclude=\"**/cli-bracket-audit*\" --exclude=\"**/cli-season-postseason-audit*\" --exclude=\"**/cli-season-free-agency*\" --exclude=\"**/cli-season-rosters*\" --exclude=\"**/cli-season-m25*\" --exclude=\"**/cli-season-block*\" --exclude=\"**/cli-season-home-court*\" --exclude=\"**/cli-defense-bpm-correlation*\" --exclude=\"**/pool-identity*\" --exclude=\"**/commands/import*\" --exclude=\"**/gen-season-free-agency-index*\" --exclude=\"**/*generator*\" --exclude=\"**/*properties*\" --exclude=\"**/block-determinism*\" --exclude=\"**/bracket/schedule*\" --exclude=\"**/season/schedule*\" --exclude=\"**/season/standings*\" --exclude=\"**/season/rotation*\" --exclude=\"**/season/aggregates*\" --exclude=\"**/season/game-summary*\" --exclude=\"**/season/block*\" --exclude=\"**/season/checkpoint*\" --exclude=\"**/season/trades*\" --exclude=\"**/season/recap*\" --exclude=\"**/season/health*\" --exclude=\"**/season/ai*\" --exclude=\"**/*effects*\" --exclude=\"**/sim/sensitivity*\" --exclude=\"**/*slot-permutations*\" --exclude=\"**/projection/candidate-search*\" --exclude=\"**/season-run-free-agency*\" --exclude=\"**/season-completed-listing*\" --exclude=\"**/season-postseason-runner*\" --exclude=\"**/*history*\" --exclude=\"**/reconstruction*\" --exclude=\"**/*integration*\"",
    "test:import-nba": "python -m unittest discover -s scripts/import-nba -p \"test_*.py\"",
    "static": "pnpm --parallel -r run \"/^(check|lint)$/\"",
    "e2e": "pnpm --filter @hoop-rush/web e2e",
    "e2e:smoke": "pnpm --filter @hoop-rush/web e2e:smoke",
    "verify:quick": "pnpm static && pnpm test:quick",
    "verify": "pnpm static && pnpm test:run && pnpm build",
    "verify:changed": "pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present run \"/^(check|lint)$/\" && pnpm --filter \"...[HEAD]\" --filter \"!hoop-rush\" --parallel --if-present test:run",
    "check:watch:web": "pnpm --filter @hoop-rush/web check:watch",
    "test:watch:web": "vitest watch --project @hoop-rush/web",
    "test:watch:engine": "vitest watch --project @hoop-rush/engine",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.11.0",
  "lint-staged": {
    "*.{ts,js,svelte,json,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@sveltejs/mcp": "^0.1.25",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
