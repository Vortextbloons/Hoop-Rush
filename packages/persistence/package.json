{
  "name": "@hoop-rush/persistence",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --incremental",
    "lint": "prettier --cache --check src eslint.config.js && eslint --cache .",
    "test": "bun test --watch --isolate --preload ./src/test-setup.ts",
    "test:run": "bun test --isolate --preload ./src/test-setup.ts",
    "test:quick": "bun test --isolate --preload ./src/test-setup.ts --path-ignore-patterns \"**/*generator*\" --path-ignore-patterns \"**/*integration*\""
  },
  "dependencies": {
    "@hoop-rush/data-contracts": "workspace:*",
    "@hoop-rush/engine": "workspace:*",
    "dexie": "^4.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hoop-rush/test-fixtures": "workspace:*",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
