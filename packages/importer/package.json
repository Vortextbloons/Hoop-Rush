{
  "name": "@hoop-rush/importer",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --incremental",
    "test": "bun test --watch --isolate",
    "test:run": "bun test --isolate",
    "test:quick": "bun test --isolate --path-ignore-patterns \"**/*generator*\" --path-ignore-patterns \"**/*integration*\"",
    "lint": "prettier --cache --check src eslint.config.js && eslint --cache ."
  },
  "dependencies": {
    "@hoop-rush/data-contracts": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
