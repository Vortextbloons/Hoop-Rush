{
  "name": "@hoop-rush/engine",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --incremental",
    "lint": "prettier --cache --check src eslint.config.js && eslint --cache .",
    "test": "bun test --watch --isolate --timeout 45000 --retry 1",
    "test:run": "bun test --isolate --timeout 45000 --retry 1",
    "test:quick": "bun test --isolate --timeout 45000 --retry 1 --path-ignore-patterns \"**/*generator*\" --path-ignore-patterns \"**/*integration*\""
  },
  "dependencies": {
    "@hoop-rush/data-contracts": "workspace:*"
  },
  "devDependencies": {
    "@hoop-rush/test-fixtures": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
